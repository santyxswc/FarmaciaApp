<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FarmaciaApp.Desktop.Views.AgregarEditarProveedorView"
        Title="{Binding Titulo}"
        Width="460" Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Titulo}" FontSize="22" FontWeight="Bold" Margin="0 0 0 10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button Content="Guardar" Width="100" Command="{Binding GuardarCommand}"/>
            <Button Content="Cancelar" Width="100" Background="Gray" Command="{Binding CancelarCommand}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <TextBlock Classes="title" Text="Nombre del Proveedor:"/>
            <TextBox Text="{Binding Nombre}"/>
            <TextBlock Classes="title" Text="Persona de Contacto:"/>
            <TextBox Text="{Binding Contacto}"/>
            <TextBlock Classes="title" Text="Teléfono:"/>
            <TextBox Text="{Binding Telefono}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
