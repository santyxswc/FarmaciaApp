<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FarmaciaApp.Desktop.Views.ClientesView"
             Background="White">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Classes="header" Text="Gestión de Clientes"/>

        <WrapPanel DockPanel.Dock="Top" Margin="0 0 0 10">
            <WrapPanel.Styles>
                <Style Selector="WrapPanel > Button">
                    <Setter Property="Margin" Value="0,0,10,5"/>
                </Style>
            </WrapPanel.Styles>
            <Button Content="Agregar Cliente" Width="160" Command="{Binding AgregarCommand}"/>
            <Button Content="Editar" Width="100" Command="{Binding EditarCommand}"/>
            <Button Content="Eliminar" Width="100" Command="{Binding EliminarCommand}"/>
            <Button Content="Actualizar" Width="100" Command="{Binding RefreshCommand}"/>
            <TextBox Width="200" Margin="10,0,10,5" VerticalAlignment="Center" Watermark="Buscar..."
                     Text="{Binding SearchTerm}"/>
            <Button Content="Buscar" Width="90" Command="{Binding BuscarCommand}"/>
        </WrapPanel>

        <DataGrid ItemsSource="{Binding Clientes}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  BorderThickness="1" BorderBrush="#dfe6e9"
                  SelectedItem="{Binding Seleccionado, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding PerId}" Width="80"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding PerNombre}" Width="150"/>
                <DataGridTextColumn Header="Apellido" Binding="{Binding PerApellido}" Width="150"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding PerTelefono}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding PerEmail}" Width="*"/>
                <DataGridTextColumn Header="Dirección" Binding="{Binding PerDireccion}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
