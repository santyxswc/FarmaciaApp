<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FarmaciaApp.Desktop.Views.CambiarClaveView"
        Title="{Binding Titulo}"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="White">
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Classes="titulo-pagina" FontSize="20" Text="{Binding Titulo}" TextWrapping="Wrap"/>
            <TextBlock Classes="subtitulo-pagina" Text="{Binding Descripcion}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,22,0,0">
            <Button Classes="secundario" Content="Cancelar" Width="110" IsCancel="True" Command="{Binding CancelarCommand}"/>
            <Button Content="Guardar" Width="110" IsDefault="True" Command="{Binding GuardarCommand}"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Classes="error" Margin="0,16,0,0"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}"/>
        </Border>
        <StackPanel>
            <StackPanel IsVisible="{Binding EsPropia}">
                <TextBlock Classes="etiqueta" Text="Contraseña actual"/>
                <TextBox Text="{Binding Actual}" PasswordChar="●"/>
            </StackPanel>
            <TextBlock Classes="etiqueta" Text="Nueva contraseña"/>
            <TextBox Text="{Binding Nueva}" PasswordChar="●"/>
            <TextBlock Classes="ayuda" Text="Mínimo 6 caracteres"/>
            <TextBlock Classes="etiqueta" Text="Confirmar nueva contraseña"/>
            <TextBox Text="{Binding Confirmacion}" PasswordChar="●"/>
        </StackPanel>
    </DockPanel>
</Window>
