<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FarmaciaApp.Desktop.Views.AgregarEditarPersonaView"
        Title="{Binding Titulo}"
        Width="460" Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Titulo}" FontSize="22" FontWeight="Bold" Margin="0 0 0 10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button Content="Guardar" Width="100" Command="{Binding GuardarCommand}"/>
            <Button Content="Cancelar" Width="100" Background="Gray" Command="{Binding CancelarCommand}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <TextBlock Classes="title" Text="Nombre:"/>
            <TextBox Text="{Binding Nombre}"/>
            <TextBlock Classes="title" Text="Apellido:"/>
            <TextBox Text="{Binding Apellido}"/>
            <TextBlock Classes="title" Text="Dirección:"/>
            <TextBox Text="{Binding Direccion}"/>
            <TextBlock Classes="title" Text="Teléfono:"/>
            <TextBox Text="{Binding Telefono}"/>
            <TextBlock Classes="title" Text="Email:"/>
            <TextBox Text="{Binding Email}"/>
            <CheckBox IsChecked="{Binding EsVendedor}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Es vendedor" FontWeight="SemiBold"/>
                    <TextBlock Text="Puede registrar ventas en la farmacia" Foreground="Gray" FontSize="12"/>
                </StackPanel>
            </CheckBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
