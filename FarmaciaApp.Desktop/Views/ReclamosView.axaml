<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:FarmaciaApp.Core"
             x:Class="FarmaciaApp.Desktop.Views.ReclamosView"
             Background="#f5f6fa">
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Classes="titulo-pagina" Text="Reclamos"/>
            <TextBlock Classes="subtitulo-pagina" Text="Peticiones y reclamos de los clientes"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Classes="panel" Padding="12,8" Margin="0,0,0,12">
            <WrapPanel>
                <WrapPanel.Styles>
                    <Style Selector="WrapPanel > Button, WrapPanel > TextBox">
                        <Setter Property="Margin" Value="0,4,8,4"/>
                    </Style>
                </WrapPanel.Styles>
                <Button Content="Agregar reclamo" Command="{Binding AgregarCommand}"/>
                <Button Classes="secundario" Content="Editar" Command="{Binding EditarCommand}"/>
                <Button Classes="peligro" Content="Eliminar" Command="{Binding EliminarCommand}" IsVisible="{x:Static core:Sesion.EsAdmin}"/>
                <Button Classes="secundario" Content="Actualizar" Command="{Binding RefreshCommand}"/>
                <TextBox Width="230" Watermark="Buscar... (Enter)" Text="{Binding SearchTerm}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding BuscarCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Classes="secundario" Content="Buscar" Command="{Binding BuscarCommand}"/>
            </WrapPanel>
        </Border>

        <Border Classes="panel" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Reclamos}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectedItem="{Binding Seleccionado, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N°" Binding="{Binding RecId}" Width="70"/>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding RecFecha, StringFormat='{}{0:dd/MM/yyyy}'}" Width="105"/>
                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="*"/>
                    <DataGridTextColumn Header="Factura" Binding="{Binding FacNumFactura}" Width="100"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding RecEstado}" Width="115"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding RecDescripcion}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
