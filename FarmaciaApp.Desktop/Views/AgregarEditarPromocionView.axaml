<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FarmaciaApp.Desktop.Views.AgregarEditarPromocionView"
        Title="{Binding Titulo}"
        Width="460" Height="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Titulo}" FontSize="22" FontWeight="Bold" Margin="0 0 0 10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button Content="Guardar" Width="100" Command="{Binding GuardarCommand}"/>
            <Button Content="Cancelar" Width="100" Background="Gray" Command="{Binding CancelarCommand}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <TextBlock Classes="title" Text="Descripción:"/>
            <TextBox Text="{Binding Descripcion}"/>
            <TextBlock Classes="title" Text="Descuento (%):"/>
            <TextBox Text="{Binding Descuento}"/>
            <TextBlock Classes="title" Text="Fecha Inicio:"/>
            <DatePicker SelectedDate="{Binding FechaInicio}" HorizontalAlignment="Stretch"/>
            <TextBlock Classes="title" Text="Fecha Fin:"/>
            <DatePicker SelectedDate="{Binding FechaFin}" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
