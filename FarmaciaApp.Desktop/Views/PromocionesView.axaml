<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:FarmaciaApp.Core"
             x:Class="FarmaciaApp.Desktop.Views.PromocionesView"
             Background="#f5f6fa">
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Classes="titulo-pagina" Text="Promociones"/>
            <TextBlock Classes="subtitulo-pagina" Text="Descuentos y fechas de vigencia"/>
        </StackPanel>

        <!-- Acciones y busqueda -->
        <Border DockPanel.Dock="Top" Classes="panel" Padding="12,8" Margin="0,0,0,12">
            <WrapPanel>
                <WrapPanel.Styles>
                    <Style Selector="WrapPanel > Button, WrapPanel > TextBox">
                        <Setter Property="Margin" Value="0,4,8,4"/>
                    </Style>
                </WrapPanel.Styles>
                <Button Content="Agregar promoción" Command="{Binding AgregarCommand}" IsVisible="{x:Static core:Sesion.EsAdmin}"/>
                <Button Classes="secundario" Content="Editar" Command="{Binding EditarCommand}" IsVisible="{x:Static core:Sesion.EsAdmin}"/>
                <Button Classes="peligro" Content="Eliminar" Command="{Binding EliminarCommand}" IsVisible="{x:Static core:Sesion.EsAdmin}"/>
                <Button Classes="secundario" Content="Ver vigentes" Command="{Binding VerActivasCommand}"/>
                <Button Classes="secundario" Content="Actualizar" Command="{Binding RefreshCommand}"/>
                <TextBox Width="230" Watermark="Buscar... (Enter)" Text="{Binding SearchTerm}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding BuscarCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Classes="secundario" Content="Buscar" Command="{Binding BuscarCommand}"/>
            </WrapPanel>
        </Border>

        <Border Classes="panel" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Promociones}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectedItem="{Binding Seleccionado, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding PrmId}" Width="60"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding PrmDescripcion}" Width="2*"/>
                    <DataGridTextColumn Header="Descuento %" Binding="{Binding PrmDescuento}" Width="115"/>
                    <DataGridTextColumn Header="Inicio" Binding="{Binding PrmFechaIni, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110"/>
                    <DataGridTextColumn Header="Fin" Binding="{Binding PrmFechaFin, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110"/>
                    <DataGridTemplateColumn Header="Estado" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#e3f9ef" CornerRadius="10" Padding="10,3" Margin="12,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding EstaActiva}">
                                    <TextBlock Text="Vigente" Foreground="#0a7a4f" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
