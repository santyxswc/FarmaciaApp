<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FarmaciaApp.Desktop.Views.LoginView"
        Title="Iniciar Sesión"
        Width="450" Height="380"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#f5f6fa">
    <Border Background="White" CornerRadius="10" Padding="20" Width="300"
            VerticalAlignment="Center" HorizontalAlignment="Center"
            BoxShadow="0 2 10 0 #22000000">
        <StackPanel>
            <TextBlock Text="Farmacia - Login" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0 0 0 20"/>

            <TextBlock Text="Usuario" Margin="0 0 0 5"/>
            <TextBox Text="{Binding Username}"/>

            <TextBlock Text="Contraseña" Margin="0 10 0 5"/>
            <TextBox Text="{Binding Password}" PasswordChar="●"/>

            <Button Content="Iniciar Sesión" Margin="0 20 0 0" HorizontalAlignment="Stretch"
                    IsDefault="True" Command="{Binding LoginCommand}"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                       Margin="0 10 0 0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
