<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FarmaciaApp.Desktop.Views.AgregarEditarClienteView"
        Title="Agregar/Editar Cliente"
        Width="460" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Cliente" FontSize="22" FontWeight="Bold" Margin="0 0 0 10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button Content="Guardar" Width="100" Command="{Binding SaveCommand}"/>
            <Button Content="Cancelar" Width="100" Background="Gray" Command="{Binding CancelCommand}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <TextBlock Classes="title" Text="Nombre"/>
            <TextBox Text="{Binding Form.PerNombre}"/>
            <TextBlock Classes="title" Text="Apellido"/>
            <TextBox Text="{Binding Form.PerApellido}"/>
            <TextBlock Classes="title" Text="Dirección"/>
            <TextBox Text="{Binding Form.PerDireccion}"/>
            <TextBlock Classes="title" Text="Teléfono"/>
            <TextBox Text="{Binding Form.PerTelefono}"/>
            <TextBlock Classes="title" Text="Email"/>
            <TextBox Text="{Binding Form.PerEmail}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
