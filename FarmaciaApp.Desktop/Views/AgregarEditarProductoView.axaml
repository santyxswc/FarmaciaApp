<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FarmaciaApp.Desktop.Views.AgregarEditarProductoView"
        Title="Agregar/Editar Producto"
        Width="460" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Producto" FontSize="22" FontWeight="Bold" Margin="0 0 0 10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button Content="Guardar" Width="100" Command="{Binding SaveCommand}"/>
            <Button Content="Cancelar" Width="100" Background="Gray" Command="{Binding CancelCommand}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <TextBlock Classes="title" Text="Nombre"/>
            <TextBox Text="{Binding Form.ProNombre}"/>
            <TextBlock Classes="title" Text="Precio"/>
            <TextBox Text="{Binding Form.ProPrecio}"/>
            <TextBlock Classes="title" Text="Stock"/>
            <TextBox Text="{Binding Form.ProStock}"/>
            <TextBlock Classes="title" Text="Descripción"/>
            <TextBox Text="{Binding Form.ProDescripcion}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
