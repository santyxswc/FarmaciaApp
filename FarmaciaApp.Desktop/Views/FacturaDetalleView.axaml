<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FarmaciaApp.Desktop.Views.FacturaDetalleView"
        Title="{Binding FacNumFactura, StringFormat='Factura N° {0}'}"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding FacNumFactura, StringFormat='Factura N° {0}'}"
                   FontSize="22" FontWeight="Bold" Margin="0 0 0 12"/>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,12">
            <Grid.Styles>
                <Style Selector="TextBlock.etiqueta">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Setter Property="Margin" Value="0,0,10,6"/>
                </Style>
            </Grid.Styles>
            <TextBlock Classes="etiqueta" Text="Fecha:"/>
            <TextBlock Grid.Column="1" Text="{Binding FacFecha, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>
            <TextBlock Grid.Column="2" Classes="etiqueta" Text="Pago:"/>
            <TextBlock Grid.Column="3" Text="{Binding MetodoPago}"/>
            <TextBlock Grid.Row="1" Classes="etiqueta" Text="Cliente:"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ClienteNombre}" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Classes="etiqueta" Text="Vendedor:"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding VendedorNombre}"/>
        </Grid>

        <Button DockPanel.Dock="Bottom" Content="Cerrar" Width="100" HorizontalAlignment="Right"
                Margin="0,12,0,0" Click="Cerrar_Click"/>

        <Border DockPanel.Dock="Bottom" Background="#f5f6fa" CornerRadius="8" Padding="16,10" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Column="1" Text="Subtotal:" Margin="0,0,16,0" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="{Binding FacSubtotal, StringFormat='{}{0:C2}'}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="IVA (19%):" Margin="0,0,16,0" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding FacIva, StringFormat='{}{0:C2}'}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Total:" FontSize="18" FontWeight="Bold" Margin="0,4,16,0" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding FacTotal, StringFormat='{}{0:C2}'}" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="All" BorderThickness="1" BorderBrush="#dfe6e9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Producto" Binding="{Binding ProNombre}" Width="*"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="105"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnitario, StringFormat='{}{0:C2}'}" Width="130"/>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalLinea, StringFormat='{}{0:C2}'}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
