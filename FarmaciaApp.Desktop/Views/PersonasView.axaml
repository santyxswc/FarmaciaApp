<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:FarmaciaApp.Core"
             x:Class="FarmaciaApp.Desktop.Views.PersonasView"
             Background="#f5f6fa">
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Classes="titulo-pagina" Text="Personas"/>
            <TextBlock Classes="subtitulo-pagina" Text="Datos personales de clientes, vendedores y empleados"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Classes="panel" Padding="12,8" Margin="0,0,0,12">
            <WrapPanel>
                <WrapPanel.Styles>
                    <Style Selector="WrapPanel > Button, WrapPanel > TextBox">
                        <Setter Property="Margin" Value="0,4,8,4"/>
                    </Style>
                </WrapPanel.Styles>
                <Button Content="Agregar persona" Command="{Binding AgregarCommand}"/>
                <Button Classes="secundario" Content="Editar" Command="{Binding EditarCommand}"/>
                <Button Classes="peligro" Content="Eliminar" Command="{Binding EliminarCommand}" IsVisible="{x:Static core:Sesion.EsAdmin}"/>
                <Button Classes="secundario" Content="Actualizar" Command="{Binding RefreshCommand}"/>
                <TextBox Width="230" Watermark="Buscar... (Enter)" Text="{Binding SearchTerm}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding BuscarCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Classes="secundario" Content="Buscar" Command="{Binding BuscarCommand}"/>
            </WrapPanel>
        </Border>

        <Border Classes="panel" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Personas}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectedItem="{Binding Seleccionado, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding PerId}" Width="60"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding PerNombre}" Width="120"/>
                    <DataGridTextColumn Header="Apellido" Binding="{Binding PerApellido}" Width="120"/>
                    <DataGridTextColumn Header="Dirección" Binding="{Binding PerDireccion}" Width="*"/>
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding PerTelefono}" Width="115"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding PerEmail}" Width="*"/>
                    <DataGridTextColumn Header="Rol" Binding="{Binding Roles}" Width="135"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
