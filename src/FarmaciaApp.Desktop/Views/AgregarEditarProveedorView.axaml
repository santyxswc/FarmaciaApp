<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FarmaciaApp.Desktop.Views.AgregarEditarProveedorView"
        Title="{Binding Titulo}"
        Width="480" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="White">
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <TextBlock Classes="titulo-pagina" FontSize="22" Text="{Binding Titulo}"/>
            <TextBlock Classes="subtitulo-pagina" Text="Los campos marcados con * son obligatorios"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,22,0,0">
            <Button Classes="secundario" Content="Cancelar" Width="110" IsCancel="True" Command="{Binding CancelarCommand}"/>
            <Button Content="Guardar" Width="110" IsDefault="True" Command="{Binding GuardarCommand}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel>
                    <TextBlock Classes="etiqueta" Text="Nombre del proveedor *"/>
                    <TextBox Text="{Binding Nombre}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="etiqueta" Text="Persona de contacto"/>
                    <TextBox Text="{Binding Contacto}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="etiqueta" Text="Teléfono"/>
                    <TextBox Text="{Binding Telefono}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
