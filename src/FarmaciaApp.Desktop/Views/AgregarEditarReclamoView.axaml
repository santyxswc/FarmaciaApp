<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FarmaciaApp.Desktop.Views.AgregarEditarReclamoView"
        Title="{Binding Titulo}"
        Width="540" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="White">
    <DockPanel Margin="28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <TextBlock Classes="titulo-pagina" FontSize="22" Text="{Binding Titulo}"/>
            <TextBlock Classes="subtitulo-pagina" Text="Los campos marcados con * son obligatorios"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,22,0,0">
            <Button Classes="secundario" Content="Cancelar" Width="110" IsCancel="True" Command="{Binding CancelarCommand}"/>
            <Button Content="Guardar" Width="110" IsDefault="True" Command="{Binding GuardarCommand}"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Classes="error" Margin="0,16,0,0"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}"/>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel>
                    <TextBlock Classes="etiqueta" Text="Factura *"/>
                    <ComboBox ItemsSource="{Binding Facturas}" SelectedItem="{Binding FacturaSeleccionada}" IsEnabled="{Binding EsNuevo}" PlaceholderText="Selecciona la factura" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="etiqueta" Text="Estado"/>
                    <ComboBox ItemsSource="{Binding Estados}" SelectedItem="{Binding Estado}" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="etiqueta" Text="Descripción *"/>
                    <TextBox Text="{Binding Descripcion}" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalContentAlignment="Top" Watermark="¿Qué pasó con la compra?"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
